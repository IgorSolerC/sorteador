rules_version = '2';

// O link do grupo é a credencial: quem o tem, lê e escreve. Estas regras não dizem quem é
// a pessoa — elas garantem o formato e, sobretudo, que o log de eventos é imutável e
// carimbado pelo servidor.
//
// Decisão central: o grupo NÃO guarda estado derivado. Um campo de estado gravável seria
// um vencedor forjável, porque nenhuma regra consegue replicar um log para conferi-lo.
// O cliente deriva tudo do log. O que sobra no doc do grupo é só o que as regras sabem
// validar sozinhas.
service cloud.firestore {
  match /databases/{database}/documents {

    // Auth anônima: não identifica a pessoa, mas dá um uid estável por dispositivo
    // e impede que um script sem token nenhum escreva no banco.
    function signedIn() {
      return request.auth != null;
    }

    function texto(valor, maximo) {
      return valor is string && valor.size() > 0 && valor.size() <= maximo;
    }

    // Etiqueta em branco é etiqueta retirada, então aqui o vazio é legítimo.
    function textoOpcional(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    match /grupos/{grupoId} {
      allow get: if signedIn();
      // Listar é proibido: senão o link deixa de ser segredo.
      allow list: if false;

      allow create: if signedIn() && grupoNovoValido();
      allow update: if signedIn() && atualizacaoValida();
      allow delete: if false;

      function grupoNovoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nome', 'criadoEm', 'ultimoGiroEm', 'versaoLog'])
          && texto(d.nome, 60)
          && d.criadoEm == request.time
          && d.ultimoGiroEm == null
          && d.versaoLog == 0;
      }

      function atualizacaoValida() {
        let antes = resource.data;
        let depois = request.resource.data;
        return depois.keys().hasOnly(['nome', 'criadoEm', 'ultimoGiroEm', 'versaoLog'])
          && depois.nome == antes.nome
          && depois.criadoEm == antes.criadoEm
          // O contador acompanha o log: um evento, um passo.
          && depois.versaoLog == antes.versaoLog + 1
          && depois.versaoLog <= 20000
          // A marca do último giro, quando muda, é a hora do servidor.
          && (depois.ultimoGiroEm == antes.ultimoGiroEm || depois.ultimoGiroEm == request.time);
      }

      match /eventos/{eventoId} {
        allow get, list: if signedIn();
        allow create: if signedIn() && eventoValido();
        // O log é a verdade: nada nele pode ser reescrito nem apagado.
        allow update, delete: if false;

        function grupoAntes() {
          return get(/databases/$(database)/documents/grupos/$(grupoId)).data;
        }

        function grupoDepois() {
          return getAfter(/databases/$(database)/documents/grupos/$(grupoId)).data;
        }

        function eventoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
              'tipo', 'em', 'autor',
              'nome', 'memberId', 'cor', 'emoji',
              'giro', 'titulo', 'subtitulo', 'descricao',
              'nota', 'status', 'texto', 'retirada', 'horas',
              'diversao', 'dificuldade', 'historia', 'qualidade', 'jogabilidade',
              'mesa',
            ])
            // O carimbo é do servidor, sempre. É a única entrada que o cliente não
            // escolhe, e é dela que o sorteio tira o resultado.
            && d.em == request.time
            && d.tipo in [
              'member_added', 'member_removed', 'member_styled',
              'spin', 'spin_annotated', 'spin_reviewed', 'spin_seated',
            ]
            && (!('autor' in d) || texto(d.autor, 60))
            && (d.tipo != 'member_added' || texto(d.nome, 60))
            && (d.tipo != 'member_removed' || texto(d.memberId, 32))
            && (d.tipo != 'member_styled' || estiloValido())
            && (d.tipo != 'spin' || (giroPermitido() && marcaDeGiroCarimbada()))
            && (d.tipo != 'spin_annotated' || anotacaoValida())
            && (d.tipo != 'spin_reviewed' || resenhaValida())
            && (d.tipo != 'spin_seated' || mesaValida())
            && (d.tipo in ['spin_annotated', 'spin_reviewed', 'spin_seated'] || semCampoDeGiro())
            && (d.tipo == 'spin_seated' || !('mesa' in d))
            && (d.tipo == 'spin_annotated' || semCamposDeEtiqueta())
            && (d.tipo == 'spin_reviewed' || semCamposDeResenha())
            && (d.tipo == 'member_styled' || semCamposDeEstilo())
            && (d.tipo == 'spin' || marcaDeGiroIntacta())
            && contadorAcompanha();
        }

        // A etiqueta descreve um giro; ela nunca decide nada. As regras não conseguem
        // replicar o log para saber que o giro existe, mas sabem que ele não pode estar
        // além do fim do log — e o replay descarta o que sobrar.
        function anotacaoValida() {
          let d = request.resource.data;
          return d.giro is int
            && d.giro >= 0
            && d.giro < grupoAntes().versaoLog
            && textoOpcional(d.titulo, 80)
            // O subtítulo saiu do produto em setembro de 2026 — o lugar dele virou a nota
            // média, derivada das resenhas. A regra continua ACEITANDO a chave de
            // propósito: uma aba aberta no minuto do deploy ainda a manda, e recusá-la
            // quebraria quem está com o app na tela. O replay não a lê mais.
            && (!('subtitulo' in d) || textoOpcional(d.subtitulo, 60))
            && textoOpcional(d.descricao, 280)
            && !('nome' in d)
            && !('memberId' in d);
        }

        // A aparência de uma cápsula: a cor é uma posição na paleta, nunca um hexadecimal
        // livre — é o que garante que toda cápsula continue passando no contraste sem que
        // as regras precisem saber calcular contraste. Um evento sem cor nem emoji não
        // muda nada e só gastaria uma escrita, então também não passa.
        function estiloValido() {
          let d = request.resource.data;
          return texto(d.memberId, 32)
            && (!('cor' in d) || (d.cor is int && d.cor >= 0 && d.cor < 24))
            && (!('emoji' in d) || textoOpcional(d.emoji, 16))
            && ('cor' in d || 'emoji' in d)
            && !('nome' in d);
        }

        // A resenha é a opinião de UMA pessoa sobre o jogo daquele giro. O servidor não
        // sabe quem é quem — `autor` é um crachá, não uma credencial —, mas sabe que uma
        // resenha sem assinatura não é de ninguém e ninguém conseguiria editá-la depois.
        // Por isso aqui, e só aqui, o autor é obrigatório.
        //
        // A nota média NÃO é gravada em lugar nenhum: ela é derivada das resenhas pelo
        // replay. Um campo de média gravável seria um número que alguém escreve à mão,
        // exatamente o que o campo de vencedor gravável já foi.
        function resenhaValida() {
          let d = request.resource.data;
          return d.giro is int
            && d.giro >= 0
            && d.giro < grupoAntes().versaoLog
            && texto(d.autor, 60)
            && (retiradaDeResenha() || resenhaEscrita())
            && !('nome' in d)
            && !('memberId' in d);
        }

        // Retirar a própria resenha é gravar a retirada, como tudo neste log. Um evento de
        // retirada não carrega nota nenhuma: ele diz apenas que aquilo deixou de valer.
        function retiradaDeResenha() {
          let d = request.resource.data;
          return ('retirada' in d) && d.retirada == true
            && !('nota' in d) && !('status' in d) && !('texto' in d) && !('horas' in d)
            && semNotasDeCriterio();
        }

        function resenhaEscrita() {
          let d = request.resource.data;
          return !('retirada' in d)
            // Nota final e completude são o mínimo: sem os dois não há opinião, e a conta
            // do álbum ficaria com denominador escondido.
            && notaValida(d.nota)
            && d.status in ['platinado', 'finalizado', 'incompleto']
            && (!('texto' in d) || textoOpcional(d.texto, 600))
            // Tempo de jogo é opcional e em horas inteiras. Zero hora não é um tempo: é a
            // ausência dele, e a ausência já se diz não mandando a chave.
            && (!('horas' in d) || (d.horas is int && d.horas >= 1 && d.horas <= 2000))
            // Critério ausente é "não avaliei", e é isso que dá a cada um o próprio
            // denominador na média. Presente, vale a mesma régua da nota final.
            && (!('diversao' in d) || notaValida(d.diversao))
            && (!('dificuldade' in d) || notaValida(d.dificuldade))
            && (!('historia' in d) || notaValida(d.historia))
            && (!('qualidade' in d) || notaValida(d.qualidade))
            && (!('jogabilidade' in d) || notaValida(d.jogabilidade));
        }

        // A mesa diz quem JOGOU aquele jogo, e nunca quem estava no globo. O globo de um
        // giro é imutável porque é dele que o vencedor sai: se esta correção pudesse
        // alterá-lo, o vencedor de um giro de meses atrás mudaria com uma escrita, e o
        // sorteio inteiro deixaria de ser reproduzível a partir do registro. Por isso ela
        // é um evento novo, e não uma reescrita — o log continua append-only.
        function mesaValida() {
          let d = request.resource.data;
          return d.giro is int
            && d.giro >= 0
            && d.giro < grupoAntes().versaoLog
            && texto(d.memberId, 32)
            && d.mesa is bool
            && !('nome' in d);
        }

        // Toda nota é um inteiro de 0 a 10. A régua da ficha tem onze casas, e uma nota
        // fora dela envenenaria a média de um jogo para sempre — o log não se reescreve.
        function notaValida(valor) {
          return valor is int && valor >= 0 && valor <= 10;
        }

        function semNotasDeCriterio() {
          let d = request.resource.data;
          return !('diversao' in d) && !('dificuldade' in d) && !('historia' in d)
            && !('qualidade' in d) && !('jogabilidade' in d);
        }

        function semCampoDeGiro() {
          return !('giro' in request.resource.data);
        }

        function semCamposDeEtiqueta() {
          let d = request.resource.data;
          return !('titulo' in d) && !('subtitulo' in d) && !('descricao' in d);
        }

        function semCamposDeResenha() {
          let d = request.resource.data;
          return !('nota' in d) && !('status' in d) && !('texto' in d) && !('retirada' in d)
            && !('horas' in d) && semNotasDeCriterio();
        }

        function semCamposDeEstilo() {
          let d = request.resource.data;
          return !('cor' in d) && !('emoji' in d);
        }

        // Só um giro mexe no relógio do giro. Sem isto, anotar em rajada empurraria a
        // espera de 30s e travaria a máquina do grupo inteiro sem girar uma vez.
        function marcaDeGiroIntacta() {
          return grupoDepois().ultimoGiroEm == grupoAntes().ultimoGiroEm;
        }

        // E todo giro TEM que carimbar esse relógio. Sem esta metade, a espera de 30s era
        // conselho: bastava gravar o giro sem mexer na marca para o relógio ficar parado e
        // o giro seguinte passar na hora. A espera existe para encarecer girar de novo até
        // gostar do resultado, e um cliente que escolhe não carimbar a anulava sozinho.
        function marcaDeGiroCarimbada() {
          return grupoDepois().ultimoGiroEm == request.time;
        }

        // Um evento não entra sozinho: o contador do grupo tem que subir na mesma escrita.
        // Sem isso o contador mente, e um cliente que confia nele para buscar só as
        // novidades nunca enxerga os eventos escondidos.
        function contadorAcompanha() {
          return grupoDepois().versaoLog == grupoAntes().versaoLog + 1;
        }

        // Um giro a cada 30 segundos por grupo. Não impede má-fé — quem não gostou do
        // resultado pode girar de novo — mas encarece, e o log deixa a tentativa à vista.
        function giroPermitido() {
          let grupo = grupoAntes();
          return grupo.ultimoGiroEm == null
            || request.time > grupo.ultimoGiroEm + duration.value(30, 's');
        }
      }
    }

    // Nada mais existe neste banco.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
